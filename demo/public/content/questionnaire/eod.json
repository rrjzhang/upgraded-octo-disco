            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
            ]
          },
          "instrument": "biis2",
          "n": 4,
          "subscale": "harmony",
          "reverse": false,
          "facet": "harmony"
        },
        {
          "id": "biis2_05",
          "type": "likert",
          "text": "I feel torn between {H} and {M} cultures.",
