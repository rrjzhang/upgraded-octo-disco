          "instrument": "biis2",
          "n": 6,
          "subscale": "harmony",
          "reverse": true,
          "facet": "conflict"
        },
        {
          "id": "biis2_07",
          "type": "likert",
          "text": "I feel that my {H} and {M} cultures are incompatible.",
