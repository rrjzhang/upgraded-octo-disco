          "instrument": "biis2",
          "n": 7,
          "subscale": "harmony",
          "reverse": true,
          "facet": "conflict"
        },
        {
          "id": "biis2_08",
          "type": "likert",
          "text": "I feel conflicted between the {M} and {H} ways of doing things.",
          "scale": {
            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
