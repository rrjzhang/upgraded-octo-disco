            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
            ]
          },
          "instrument": "biis2",
          "n": 5,
          "subscale": "harmony",
          "reverse": true,
          "facet": "conflict"
        },
        {
          "id": "biis2_06",
          "type": "likert",
          "text": "Being bicultural means having two cultural forces pulling on me at the same time.",
