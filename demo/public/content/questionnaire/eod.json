            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
