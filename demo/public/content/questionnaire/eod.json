{
  "id": "eod-biis2-v1",
  "title": "Evening check-in",
  "intro": "A short call before bed. Think about how you see yourself as someone with both {H} and {M} cultures, and mark how much you agree with each statement. There are no right or wrong answers.",
  "instrument": {
    "id": "biis2",
    "name": "Bicultural Identity Integration Scale, Version 2 (BIIS-2)",
    "citation": "Huynh, Q.-L., Benet-Martínez, V., & Nguyen, A.-M. D. (2018). Measuring variations in bicultural identity across U.S. ethnic and generational groups: Development and validation of the BIIS-2. Psychological Assessment. doi:10.1037/pas0000606",
    "placeholders": {
      "H": {
        "byHomeCulture": {
          "cn": "Chinese",
          "mx": "Mexican",
          "in": "Indian"
        },
        "fallback": "heritage"
      },
      "M": {
        "value": "American"
      }
    },
    "scoring": {
      "reverse": "6 - x",
      "subscales": {
        "harmony": "mean of harmony items after reversing",
        "blendedness": "mean of blendedness items after reversing"
      },
      "rawHalves": {
        "harmonyRaw": "harmony",
        "conflictRaw": "conflict",
        "blendRaw": "blend",
        "compRaw": "comp"
      },
      "referenceMeans": {
        "all": {
          "harmony": 3.63,
          "blendedness": 4.0
        }
      }
    }
  },
  "pages": [
    {
      "items": [
        {
          "id": "biis2_01",
          "type": "likert",
          "text": "I find it easy to harmonize {H} and {M} cultures.",
          "scale": {
            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
            ]
          },
          "instrument": "biis2",
          "n": 1,
          "subscale": "harmony",
          "reverse": false,
          "facet": "harmony"
        },
        {
          "id": "biis2_02",
          "type": "likert",
          "text": "I rarely feel conflicted about being bicultural.",
          "scale": {
            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
            ]
          },
          "instrument": "biis2",
          "n": 2,
          "subscale": "harmony",
          "reverse": false,
          "facet": "harmony"
        },
        {
          "id": "biis2_03",
          "type": "likert",
          "text": "I find it easy to balance both {H} and {M} cultures.",
          "scale": {
            "min": 1,
            "max": 5,
            "minLabel": "Strongly disagree",
            "maxLabel": "Strongly agree",
            "labels": [
              "Strongly disagree",
              "Disagree",
              "Neutral",
              "Agree",
              "Strongly agree"
            ]
          },
          "instrument": "biis2",
          "n": 3,
          "subscale": "harmony",
          "reverse": false,
          "facet": "harmony"
        },
        {
          "id": "biis2_04",
          "type": "likert",
          "text": "I do not feel trapped between the {H} and {M} cultures.",
