          "instrument": "biis2",
          "n": 8,
          "subscale": "harmony",
          "reverse": true,
          "facet": "conflict"
        },
        {
          "id": "biis2_09",
          "type": "likert",
          "text": "I feel like someone moving between two cultures.",
